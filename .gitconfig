[user]
	name = ྅༻ Ǭɀħ ༄༆ཉ
	email = ozh@ozh.org
    signingkey = B60CE74EAE5EE8E8
[commit]
    gpgsign = true	
[init]
	defaultBranch = master
[core]
	autocrlf = input
	eol = lf
	safecrlf = warn
	longpaths = true
	ignoreCase = false
	pager = less -FRX
	excludesFile = .gitignore-local
[http]
	postBuffer = 524288000
[pull]
	rebase = false
[gui]
	pruneduringfetch = true
[smartgit "submodule"]
	fetchalways = false
	update = true
	initializenew = true
[push]
	recurseSubmodules = check
[diff]
	tool = meld
[difftool]
	prompt = false
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[alias]
    pr = "!php /home/ozh/dev/git-pr/ozh_git_pr.php"
    # View abbreviated SHA, description, and history graph of the latest 20 commits
	l = log --color --decorate --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an (%G?)>%Creset' --abbrev-commit
	ignore-local = "!f() {\n    file=.gitignore-local\n    grep -qxF \"$file\" \"$file\" 2>/dev/null || echo \"$file\" >> \"$file\"\n    [ $# -eq 0 ] && { cat \"$file\"; return; }\n    for p in \"$@\"; do\n        grep -qxF -- \"$p\" \"$file\" || echo \"$p\" >> \"$file\"\n    done\n}; f"

